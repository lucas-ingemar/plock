{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plock.dev/schemas/haul_prompt.schema.json",
  "title": "HaulPrompt",
  "description": "A generated prompt the user can copy into their own AI assistant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prompt"
  ],
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1,
      "description": "The full prompt text."
    }
  },
  "examples": [
    {
      "prompt": "Create 5 dinner recipes for 2 adults and 1 child..."
    }
  ]
}
