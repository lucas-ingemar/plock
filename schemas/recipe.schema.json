{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plock.dev/schemas/recipe.schema.json",
  "title": "Recipe",
  "description": "A saved recipe with its reviews.",
  "allOf": [
    {
      "$ref": "recipe_base.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "id",
    "reviews"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "goJSONSchema": {
        "type": "uuid.UUID",
        "imports": [
          "github.com/gofrs/uuid/v5"
        ]
      },
      "description": "Recipe ID. UUID v4."
    },
    "reviews": {
      "type": "object",
      "description": "Reviews keyed by user ID (UUID v4). Always present; an empty object when nobody has reviewed the recipe.",
      "propertyNames": {
        "format": "uuid"
      },
      "additionalProperties": {
        "$ref": "recipe_review.schema.json"
      },
      "goJSONSchema": {
        "type": "map[uuid.UUID]RecipeReview",
        "imports": [
          "github.com/gofrs/uuid/v5"
        ]
      }
    }
  },
  "unevaluatedProperties": false,
  "examples": [
    {
      "id": "7b1e4c2a-5d3f-4a8b-9c6e-1f2a3b4c5d6e",
      "title": "Krispig sesamtofu med risnudlar",
      "description": "Krispig tofu, knapriga grönsaker och en söt-salt sesamsås.",
      "cuisine": "chinese",
      "protein": "vegan",
      "servings": 4,
      "total_time_minutes": 25,
      "difficulty": "easy",
      "ingredients": [
        {
          "quantity": 400,
          "unit": "g",
          "name": "tofu",
          "from_receipt": true
        }
      ],
      "steps": [
        {
          "text": "Stek tofun gyllene.",
          "timer_minutes": 8
        }
      ],
      "reviews": {
        "00000000-0000-0000-0000-000000000000": {
          "rating": 3,
          "children_rating": 3,
          "notes": "Dubbla såsen nästa gång."
        }
      }
    }
  ]
}
