{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plock.dev/schemas/haul-request.v1.json",
  "title": "HaulRequest",
  "description": "Household and meal preferences used to generate recipes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "household",
    "servings_per_meal",
    "meal_count",
    "max_cooking_minutes",
    "protein_preferences",
    "cuisine_preferences"
  ],
  "properties": {
    "household": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adults", "children"],
      "properties": {
        "adults": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "children": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["age_years"],
            "properties": {
              "age_years": {
                "type": "integer",
                "minimum": 0,
                "maximum": 17
              }
            }
          }
        }
      }
    },
    "servings_per_meal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "description": "Servings per meal, including any extra portions for leftovers."
    },
    "meal_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 7,
      "description": "Number of meals to plan."
    },
    "max_cooking_minutes": {
      "type": "integer",
      "enum": [20, 30, 45, 60],
      "description": "Maximum cooking time per meal."
    },
    "protein_preferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Proteins the household eats. Proteins not listed are excluded from recipes.",
      "items": { "$ref": "#/$defs/protein" }
    },
    "cuisine_preferences": {
      "type": "array",
      "uniqueItems": true,
      "description": "Preferred cuisines. An empty list means any cuisine.",
      "items": { "$ref": "#/$defs/cuisine" }
    }
  },
  "$defs": {
    "protein": {
      "type": "string",
      "enum": ["chicken", "beef", "pork", "lamb", "fish", "seafood", "vegetarian", "vegan"]
    },
    "cuisine": {
      "type": "string",
      "enum": [
        "swedish",
        "italian",
        "french",
        "spanish",
        "greek",
        "turkish",
        "moroccan",
        "indian",
        "chinese",
        "thai",
        "japanese",
        "korean",
        "vietnamese",
        "mexican",
        "american",
        "latin_american"
      ]
    }
  },
  "examples": [
    {
      "household": {
        "adults": 2,
        "children": [{ "age_years": 2 }]
      },
      "servings_per_meal": 4,
      "meal_count": 5,
      "max_cooking_minutes": 30,
      "protein_preferences": ["chicken", "pork", "fish", "vegetarian"],
      "cuisine_preferences": ["italian", "indian", "mexican", "chinese"]
    }
  ]
}
