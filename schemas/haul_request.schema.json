{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plock.dev/schemas/haul_request.schema.json",
  "title": "HaulRequest",
  "goJSONSchema": {
    "identifier": "HaulRequest"
  },
  "description": "Household and meal preferences used to generate recipes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adults",
    "children",
    "servings_per_meal",
    "meal_count",
    "max_cooking_minutes",
    "protein_preferences",
    "cuisine_preferences"
  ],
  "properties": {
    "adults": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Number of adults in the household."
    },
    "children": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "description": "Number of children in the household."
    },
    "servings_per_meal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "description": "Servings per meal, including any extra portions for leftovers."
    },
    "meal_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 7,
      "description": "Number of meals to plan."
    },
    "max_cooking_minutes": {
      "$ref": "cooking_minutes.schema.json"
    },
    "protein_preferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Proteins the household eats. Proteins not listed are excluded from recipes.",
      "items": {
        "$ref": "protein.schema.json"
      }
    },
    "cuisine_preferences": {
      "type": "array",
      "uniqueItems": true,
      "description": "Preferred cuisines. An empty list means any cuisine.",
      "items": {
        "$ref": "cuisine.schema.json"
      }
    }
  },
  "examples": [
    {
      "adults": 2,
      "children": 1,
      "servings_per_meal": 4,
      "meal_count": 5,
      "max_cooking_minutes": 30,
      "protein_preferences": [
        "chicken",
        "pork",
        "fish",
        "vegetarian"
      ],
      "cuisine_preferences": [
        "italian",
        "indian",
        "mexican",
        "chinese"
      ]
    }
  ]
}
